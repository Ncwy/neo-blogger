---
import { getCollection } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';


const posts = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);



const groupedPosts = posts.reduce(
  (acc, post) => {

    const year = post.data.pubDate.getFullYear();



    if (!acc[year]) {

      acc[year] = [];

    }



    acc[year].push(post);



    return acc;

  },
  {} as Record<string, typeof posts>
);

---

<!doctype html>
<html lang="en">

<head>

  <BaseHead
    title={`Archive | ${SITE_TITLE}`}
    description={SITE_DESCRIPTION}
  />

</head>


<body>


  <Header />


  <main>


    <h1>
      🗓 Archive
    </h1>


    <p>
      Timeline of Neo knowledge system.
    </p>



    {
      Object.entries(groupedPosts)

        .sort(
          ([a], [b]) =>
            Number(b) - Number(a)
        )

        .map(([year, yearPosts]) => (

          <section>


            <h2>

              {year}

              <span class="count">

                ({yearPosts.length})

              </span>

            </h2>



            <ul>


              {
                yearPosts.map((post) => (

                  <li>


                    <a
                      href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
                    >

                      {post.data.title}

                    </a>



                    <span class="date">

                      {
                        post.data.pubDate.toLocaleDateString(
                          'en-US',
                          {
                            month: 'short',
                            day: 'numeric',
                          }
                        )
                      }

                    </span>


                  </li>

                ))
              }


            </ul>


          </section>

        ))
    }


  </main>


  <Footer />


</body>

</html>



<style>

main {

  width:
    calc(100% - 2em);


  max-width:
    720px;


  margin:
    auto;


  padding:
    3rem 0;

}



section {

  margin-top:
    3rem;

}



h2 {

  display:
    flex;


  align-items:
    center;


  gap:
    0.5rem;

}



.count {

  color:
    rgb(var(--gray));


  font-size:
    0.8em;


  font-weight:
    normal;

}



ul {

  list-style:
    none;


  padding:
    0;


  margin:
    0;

}



li {

  display:
    flex;


  justify-content:
    space-between;


  align-items:
    center;


  padding:
    0.8rem 0;


  border-bottom:

    1px solid

    rgb(var(--gray-light));

}



a {

  text-decoration:
    none;

}



.date {

  color:
    rgb(var(--gray));


  font-size:
    0.9rem;

}



</style>