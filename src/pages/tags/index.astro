---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

import {
	SITE_TITLE,
	SITE_DESCRIPTION
} from '../../consts';



const posts = await getCollection('blog');



const tagMap = new Map();



posts.forEach((post)=>{


	post.data.tags?.forEach((tag)=>{


		if(tagMap.has(tag)){

			tagMap.set(
				tag,
				tagMap.get(tag)+1
			);

		}else{

			tagMap.set(tag,1);

		}


	});


});



const tags =
	Array.from(tagMap.entries())
	.sort(
		(a,b)=>b[1]-a[1]
	);

---



<!doctype html>

<html lang="en">


<head>

<BaseHead

	title={`Tags | ${SITE_TITLE}`}

	description={SITE_DESCRIPTION}

/>

</head>



<body>


<Header />


<main>


<section class="header">


<h1>

🏷 Tags

</h1>


<p>

Explore topics from Neo knowledge system.

</p>


</section>




<section class="tags">


{

tags.map(([tag,count])=>(

<a

href={`${import.meta.env.BASE_URL}tags/${tag}/`}

>

<span>

{tag}

</span>


<small>

({count})

</small>


</a>


))

}


</section>


</main>



<Footer />


</body>


</html>




<style>


main{

	width:

	calc(100% - 2rem);

	max-width:

	900px;

	margin:auto;

}



.header{

	text-align:center;

	padding:

	4rem 0 3rem;

}



.header h1{

	font-size:3rem;

}



.header p{

	color:

	rgb(var(--gray));

}



.tags{


display:flex;

flex-wrap:wrap;

justify-content:center;

gap:1rem;


}



.tags a{


padding:

1rem 1.5rem;


border-radius:999px;


background:

rgba(var(--gray-light),0.3);


text-decoration:none;


color:

rgb(var(--gray-dark));


transition:.2s;


}



.tags a:hover{


transform:translateY(-3px);


box-shadow:

var(--box-shadow);


}



small{

	margin-left:.5rem;

	color:

	rgb(var(--gray));

}


</style>