---
import { getCollection } from 'astro:content';

import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';

import {
	SITE_DESCRIPTION,
	SITE_TITLE
} from '../../consts';



const posts = (await getCollection('blog'))

	.sort(
		(a,b) =>
			b.data.pubDate.valueOf()
			-
			a.data.pubDate.valueOf()
	);

---



<!doctype html>

<html lang="en">


<head>

	<BaseHead

		title={`Blog | ${SITE_TITLE}`}

		description={SITE_DESCRIPTION}

	/>

</head>



<body>


<Header />



<main>


<section class="blog-header">



<div class="icon">

	📝

</div>



<h1>

	Blog

</h1>



<p>

	All articles from Neo.

</p>



<p class="subtitle">

	Thoughts,
	experiments,
	and knowledge accumulated over time.

</p>



<div class="count">

	Total posts:

	<strong>
		{posts.length}
	</strong>

</div>



</section>





<section class="articles">


<h2>

	Articles

</h2>



<PostList posts={posts} />


</section>




</main>



<Footer />



</body>



</html>




<style>


main {

	width:

		calc(100% - 2rem);

	max-width:

		960px;

	margin:auto;

}



.blog-header {

	text-align:center;

	padding:

		4rem 0 3rem;

}



.icon {

	font-size:3rem;

	margin-bottom:1rem;

}



h1 {

	font-size:3rem;

	margin-bottom:1rem;

}



.blog-header p {

	color:

		rgb(var(--gray));

	font-size:1.1rem;

}



.subtitle {

	max-width:600px;

	margin:

		1rem auto;

	line-height:1.7;

}



.count {

	margin-top:2rem;

	color:

		rgb(var(--gray-dark));

}



.articles {

	margin-top:2rem;

}



.articles h2 {

	margin-bottom:2rem;

}



</style>