---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<h1>About Neo</h1>

			<h2>
				Build systems.<br />
				Learn continuously.<br />
				Think clearly.
			</h2>

			<p>
				Neo Blog is a personal knowledge system
				documenting Trading, Life, and Ideas.
			</p>

			<h2>Three Directions</h2>

			<h3>📈 Trading</h3>
			<p>
				Recording trading journals,
				market observations,
				strategy experiments,
				and lessons learned.
			</p>

			<h3>🌱 Life</h3>
			<p>
				Exploring Career Lab,
				Life OS,
				learning systems,
				and personal growth.
			</p>

			<h3>💡 Ideas</h3>
			<p>
				Writing about thoughts,
				technology,
				business,
				and systems.
			</p>

			<h2>The Goal</h2>

			<p>
				The goal is not to write more.
				The goal is to think better,
				build better systems,
				and accumulate knowledge over time.
			</p>

		</main>

		<Footer />
	</body>
</html>