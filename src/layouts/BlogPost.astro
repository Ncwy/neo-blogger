---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';



type Props = CollectionEntry<'blog'>['data'];



const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category
} = Astro.props;



const categoryNames = {

	trading: "Trading",

	tools: "工具人系列",

	notes: "随笔",

};



const categoryName =
	categoryNames[category] ?? category;



const posts = (await getCollection('blog'))

	.sort(
		(a,b) =>
			b.data.pubDate.valueOf()
			-
			a.data.pubDate.valueOf()
	);



const currentIndex =
	posts.findIndex(
		(post) =>
			post.id === Astro.params.id
	);



const previousPost =
	posts[currentIndex + 1];



const nextPost =
	posts[currentIndex - 1];

---

<html lang="en">


<head>

	<BaseHead
		title={title}
		description={description}
	/>

</head>



<body>


<Header />



<main>


<article>


<div class="prose">



<header class="title">


{
	category && (

		<p class="back">

			<a href={`${import.meta.env.BASE_URL}${category}/`}>

				← {categoryName}

			</a>

		</p>

	)

}




<h1>

	{title}

</h1>



<p class="description">

	{description}

</p>




<p class="date">

	<FormattedDate date={pubDate} />

</p>




{
	category && (

	<p class="meta">

		📂 {categoryName}

	</p>

	)

}





{
	updatedDate && (

	<p class="updated">

		Last updated on

		<FormattedDate date={updatedDate} />

	</p>

	)

}



<hr />


</header>





{
	heroImage && (

	<div class="hero-image">


		<Image

			width={1020}

			height={510}

			src={heroImage}

			alt={title}

		/>


	</div>

	)

}





<slot />





<nav class="post-navigation">


{
	previousPost && (

	<a href={`${import.meta.env.BASE_URL}blog/${previousPost.id}/`}>

			← Previous

	</a>

	)

}




{
	nextPost && (

	<a href={`${import.meta.env.BASE_URL}blog/${nextPost.id}/`}>

			Next →

	</a>

	)

}


</nav>



</div>


</article>


</main>



<Footer />



</body>


</html>





<style>


main {

	width:
		calc(100% - 2em);


	max-width:
		720px;


	margin:
		auto;

}



.prose {

	color:
		rgb(var(--gray-dark));

}



.title {

	text-align:
		center;


	padding:
		3rem 0 2rem;

}



.title h1 {

	margin:
		0;


	line-height:
		1.2;


	font-size:
		2.5rem;

}



.description {

	color:
		rgb(var(--gray));

}



.date {

	color:
		rgb(var(--gray));


	font-size:
		0.9rem;


	margin-top:
		1.5rem;

}



.meta {

	color:
		rgb(var(--gray));


	font-size:
		0.9rem;


	margin:
		0.5rem 0;

}



.updated {

	color:
		rgb(var(--gray));


	font-size:
		0.85rem;


	font-style:
		italic;

}



.back {

	text-align:
		left;


	margin-bottom:
		1.5rem;

}



.back a {

	text-decoration:
		none;

}



.hero-image {

	margin:
		2rem 0;

}



.hero-image img {

	display:
		block;


	width:
		100%;


	height:
		auto;


	border-radius:
		12px;


	box-shadow:
		var(--box-shadow);

}



.post-navigation {

	display:
		flex;


	justify-content:
		space-between;


	gap:
		1rem;


	margin-top:
		3rem;


	padding-top:
		2rem;


	border-top:

		1px solid

		rgb(var(--gray-light));

}



.post-navigation a {

	text-decoration:
		none;

}



hr {

	margin-top:
		2rem;

}


</style>