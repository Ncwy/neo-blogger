---
const base = import.meta.env.BASE_URL;

const navItems = [
  {
    name: "Trading",
    href: `${base}trading/`,
  },
  {
    name: "工具人系列",
    href: `${base}tools/`,
  },
  {
    name: "随笔",
    href: `${base}notes/`,
  },
  {
    name: "About",
    href: `${base}about/`,
  },
];
---

<header>
  <nav>
    <a class="logo" href={base}>
      Neo
    </a>

    <div class="links">
      {
        navItems.map((item) => (
          <a href={item.href}>
            {item.name}
          </a>
        ))
      }
    </div>
  </nav>
</header>


<style>

header {

  width:
    calc(100% - 2rem);

  max-width:
    960px;

  margin:
    auto;

}


nav {

  display:
    flex;

  justify-content:
    space-between;

  align-items:
    center;

  padding:
    1.5rem 0;

}



.logo {

  font-size:
    1.5rem;

  font-weight:
    700;

  text-decoration:
    none;

  color:
    inherit;

}



.links {

  display:
    flex;

  gap:
    1.5rem;

}



.links a {

  text-decoration:
    none;

  color:
    inherit;

  font-size:
    1.5rem;

}



.links a:hover {

  opacity:
    .6;

}



@media(max-width:700px){


nav {

  flex-direction:
    column;

  align-items:
    flex-start;

  gap:
    1rem;

}


.links {

 flex-wrap:
 wrap;

}


}

</style>