---
const base = import.meta.env.BASE_URL;

const navItems = [
  {
    name: "Trading",
    href: `${base}trading/`,
  },
  {
    name: "工具人系列",
    href: `${base}tools/`,
  },
  {
    name: "随笔",
    href: `${base}notes/`,
  },
  {
    name: "About",
    href: `${base}about/`,
  },
];
---

<header>
  <nav>
    <a class="logo" href={base}>
      Neo
    </a>

    <div class="links">
      {
        navItems.map((item) => (
          <a href={item.href}>
            {item.name}
          </a>
        ))
      }
    </div>
  </nav>
</header>