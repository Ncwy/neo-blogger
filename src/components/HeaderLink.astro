---
import type { HTMLAttributes } from 'astro/types';


type Props = HTMLAttributes<'a'>;


const {
	href,
	class: className,
	...props
} = Astro.props;


const currentPath =
	Astro.url.pathname;


const targetPath =
	String(href);


const isActive =
	currentPath === targetPath ||
	(
		targetPath !== import.meta.env.BASE_URL &&
		currentPath.startsWith(targetPath)
	);

---


<a
	href={href}
	class:list={[
		className,
		{
			active: isActive
		}
	]}
	{...props}
>

	<slot />

</a>


<style>

a {

	display:inline-block;

	text-decoration:none;

}


a.active {

	font-weight:bolder;

	text-decoration:underline;

}

</style>