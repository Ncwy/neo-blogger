---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';


interface Props {

	posts: CollectionEntry<'blog'>[];

}


const { posts } = Astro.props as Props;

---



<ul>


{
	posts.map((post) => (

	<li>


		<h3 class="title">

			<a
				href={`${import.meta.env.BASE_URL}blog/${post.id}/`}
			>

				{post.data.title}

			</a>

		</h3>




		<p class="description">

			{post.data.description}

		</p>




		<p class="date">

			<FormattedDate
				date={post.data.pubDate}
			/>

		</p>



	</li>

	))
}


</ul>





<style>


ul {

	list-style:none;


	padding:0;


	margin:0;


	display:flex;


	flex-direction:column;


	gap:2rem;

}



li {

	padding-bottom:2rem;


	border-bottom:

		1px solid

		rgb(var(--gray-light));

}



.title {

	margin:

		0 0 0.8rem;

}



.title a {

	text-decoration:none;


	color:inherit;

}



.title a:hover {

	opacity:0.6;

}



.description {

	color:

		rgb(var(--gray));


	line-height:1.6;


	margin:

		0 0 0.8rem;

}



.date {

	color:

		rgb(var(--gray));


	font-size:

		0.9rem;


	margin:0;

}


</style>