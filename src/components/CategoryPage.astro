---
import { getCollection } from "astro:content";
import PostList from "./PostList.astro";


const {
	category,
	title,
	description
} = Astro.props;



const categoryNames: Record<string, string> = {

	trading: "Trading",

	tools: "工具人系列",

	notes: "随笔",

};



const displayTitle =
	categoryNames[category] ?? title;



const posts =
	await getCollection("blog");



const categoryPosts =
	posts

	.filter(
		(post) =>
			post.data.category === category
	)

	.sort(
		(a,b) =>
			b.data.pubDate.valueOf()
			-
			a.data.pubDate.valueOf()
	);

---


<section class="category">


<header>


<h1>

	{displayTitle}

</h1>


<p>

	{description}

</p>


</header>




<section class="articles">


<PostList posts={categoryPosts} />


</section>



</section>





<style>


.category {

	max-width:
		720px;


	margin:
		auto;

}




header {

	text-align:
		center;


	padding:
		4rem 0 3rem;

}




h1 {

	font-size:
		2.8rem;


	margin-bottom:
		1rem;

}




p {

	color:
		rgb(var(--gray));


	line-height:
		1.7;

}




.articles {

	margin-top:
		2rem;

}


</style>